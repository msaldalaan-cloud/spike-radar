# ══════════════════════════════════════════════════════
# SPIKE RADAR — Environment Variables
# أضف هذه في Vercel → Settings → Environment Variables
# ══════════════════════════════════════════════════════

# ── Sahmk API ──────────────────────────────────────────
SAHMK_API_KEY=your_sahmk_api_key_here

# ── EmailJS ────────────────────────────────────────────
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_TO_EMAIL=your@email.com

# ── Vercel Cron Secret (اختياري) ───────────────────────
CRON_SECRET=any_random_string_here

# ── Base URL ───────────────────────────────────────────
# في Vercel يُضاف تلقائياً — محلياً فقط:
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Vercel KV (يُضاف تلقائياً عند ربط KV من Vercel Dashboard) ──
# KV_URL=...
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...
